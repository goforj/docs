{
  "type": "module",
  "scripts": {
    "proof:refresh": "node ../bin/collect-proof-stats.mjs",
    "proof:check": "node ../bin/collect-proof-stats.mjs --check",
    "security:refresh": "node .vitepress/scripts/generate-security-coverage.mjs",
    "security:check": "node .vitepress/scripts/generate-security-coverage.mjs --check",
    "generate:editor-themes": "node .vitepress/scripts/generate-editor-themes.mjs",
    "sync:design": "node .vitepress/scripts/sync-design-css.mjs",
    "audit:content": "node .vitepress/scripts/audit-content-value.mjs",
    "predev": "npm run generate:editor-themes && npm run sync:design",
    "dev": "vitepress dev . --port=5190",
    "prebuild": "npm run generate:editor-themes && npm run sync:design && npm run security:check && npm run audit:content",
    "build": "vitepress build .",
    "postbuild": "node .vitepress/scripts/audit-built-links.mjs && node .vitepress/scripts/audit-search-quality.mjs && node --test .vitepress/scripts/library-social-metadata.test.mjs .vitepress/scripts/seo-metadata.test.mjs ../bin/refresh-release.test.mjs && npm run test:performance && node ../benchmarks/check.mjs",
    "test:library-metadata": "node --test .vitepress/scripts/library-social-metadata.test.mjs",
    "test:page-markdown": "node --test .vitepress/scripts/page-markdown.test.mjs",
    "preview": "vitepress preview .",
    "performance:refresh": "node ../bin/collect-performance-stats.mjs",
    "performance:check": "node ../bin/collect-performance-stats.mjs --check",
    "test:performance": "node --test .vitepress/theme/components/performance-measurements.test.mjs ../bin/performance-data.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vitepress": "^2.0.0-alpha.20"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@iconify-json/simple-icons": "^1.2.100",
    "mermaid": "^12.2.0",
    "three": "0.186.1"
  }
}
