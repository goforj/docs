# IDE
.idea

# Ignore all top-level markdown files
/*.md

# Except README.md
!/README.md
!/improvements.md

# Allow all markdown files in docs
!/docs/**/*.md

backend/frontend/dist/
/bin/*
!/bin/collect-proof-stats.mjs
_data/

# Local environment files
.env
.env.*
!.env.example

# FUSE cleanup artifacts
.fuse_hidden*
.DS_Store
