# IDE
.idea

# Ignore all top-level markdown files
/*.md

# Except README.md
!/README.md
!/improvements.md

# Allow all markdown files in docs
!/docs/**/*.md

backend/frontend/dist/
/bin/*
!/bin/refresh-release.mjs
!/bin/refresh-release.test.mjs
!/bin/export-performance-logos.sh
!/bin/collect-proof-stats.mjs
!/bin/collect-performance-stats.mjs
!/bin/performance-data.mjs
!/bin/performance-data.test.mjs
_data/

# Local environment files
.env
.env.*
!.env.example

# FUSE cleanup artifacts
.fuse_hidden*
.DS_Store
.playwright-mcp/
